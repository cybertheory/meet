# 1. Copy this file and rename it to .env.local
# 2. Update the enviroment variables below.

# REQUIRED SETTINGS
# ################# 
# If you are using LiveKit Cloud, the API key and secret can be generated from the Cloud Dashboard.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL pointing to the LiveKit server. (example: `wss://my-livekit-project.livekit.cloud`)
LIVEKIT_URL=


# OPTIONAL SETTINGS
# ################# 
# AI agents (Tavus avatars via LiveKit Agents). See agent/README.md for the worker.
# Setting the public endpoint enables the "AI Agents" tab in the room settings menu,
# the "AI agents to invite" field on the home page, and `?agents=N` on room URLs.
# NEXT_PUBLIC_LK_AGENTS_ENDPOINT=/api/agents
# Must match `agent_name` the Python worker registers with (default: tavus-meeting-agent).
# LIVEKIT_AGENT_NAME=tavus-meeting-agent
# LIVEKIT_MAX_AGENTS_PER_ROOM=25
# Recording
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# PUBLIC
# Uncomment settings menu when using a LiveKit Cloud, it'll enable Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site

