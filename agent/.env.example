# Copy to agent/.env.local (or agent/.env) and fill in.

# LiveKit — same project as the Next.js app
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tavus — https://platform.tavus.io
TAVUS_API_KEY=
# Optional defaults; per-agent values from dispatch metadata take precedence.
# Omit both to use Tavus' stock face/PAL.
# TAVUS_FACE_ID=
# TAVUS_PAL_ID=

# Must match LIVEKIT_AGENT_NAME in the Next.js app (default tavus-meeting-agent)
# LIVEKIT_AGENT_NAME=tavus-meeting-agent

# LiveKit Inference model descriptors (no extra provider keys needed on LiveKit Cloud)
# AGENT_STT=deepgram/nova-3:en
# AGENT_LLM=openai/gpt-4.1-mini
# AGENT_TTS=cartesia/sonic-3:a167e0f3-df7e-4d52-a9c3-f949145efdab

# Seconds with no humans in the room before an agent shuts itself down (0 = never)
# AGENT_IDLE_TIMEOUT=120
